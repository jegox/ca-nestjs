# Application
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend_napi
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=24h

# CORS — comma-separated list of allowed origins (never use * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# AI Services
OPENAI_API_KEY=
